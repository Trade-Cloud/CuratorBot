# --- Telegram ---
BOT_TOKEN=123456:replace-me
# Чат беты (supergroup с топиками)
CHAT_ID=-1001234567890
# Свой telegram-bot-api сервер, если нужны файлы > 20 МБ
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# ID топиков: написать /topic_id в каждом топике (команда работает для ADMIN_IDS). 0 = General.
TOPIC_INFO_ID=
TOPIC_CHANGELOG_ID=
TOPIC_BUGS_ID=
TOPIC_FEATURES_ID=
TOPIC_MAIN_ID=0

# Кто видит детали багов, публикует changelog и меняет статусы (через запятую)
ADMIN_IDS=
# Куда слать логи модерации и уведомления о репортах. Пусто = в ЛС админам.
ADMIN_LOG_CHAT_ID=
ADMIN_LOG_THREAD_ID=

# --- Postgres (контейнер beta_bot_postgres) ---
POSTGRES_USER=beta_bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beta_bot

TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Модерация ---
MODERATION_ENABLED=true
# Топики под модерацией через запятую; пусто = только TOPIC_MAIN_ID
MODERATION_TOPICS=
# Теги участников, которых не трогаем
EXEMPT_TAGS=ADMIN,MODER
EXEMPT_CHAT_ADMINS=true
ALLOWED_DOMAINS=trade-cloud.org
ALLOWED_MENTIONS=
BLOCK_MENTIONS=true
# ignore | log | delete
MODERATION_HARD_ACTION=delete
MODERATION_SOFT_ACTION=log
MODERATION_MUTE_AFTER=3
MODERATION_MUTE_WINDOW_HOURS=24
MODERATION_MUTE_MINUTES=60

# --- Репорты ---
BUG_ATTACHMENTS_REQUIRED=true
REQUIRE_MEMBERSHIP=true
DELETE_GROUP_COMMANDS=true

# --- Локальная LLM (пока не используется) ---
LLM_ENABLED=false
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=
