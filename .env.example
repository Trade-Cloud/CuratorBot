# Only secrets and chat/instance ids live here. Non-secret tunables (moderation, LLM, limits,
# timezone, ports) are in config.json; set any of them here as well to override.

# --- Telegram ---
BOT_TOKEN=123456:replace-me
# Beta chat (supergroup with topics)
CHAT_ID=-1001234567890
# A self-hosted telegram-bot-api server, if you need files > 20 MB
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# Topic ids: send /topic_id in each topic (works for ADMIN_IDS) or run /scan_topics. 0 = General.
TOPIC_INFO_ID=
TOPIC_CHANGELOG_ID=
TOPIC_BUGS_ID=
TOPIC_FEATURES_ID=
TOPIC_MAIN_ID=0
# Short event logs topic (optional; empty = don't post)
TOPIC_LOGS_ID=
# Moderated topics, comma-separated; empty = TOPIC_MAIN_ID only
MODERATION_TOPICS=

# Who sees bug details, publishes changelogs and changes statuses (comma-separated)
ADMIN_IDS=
# Where to send moderation logs and report notifications. Empty = to admins' private chats.
ADMIN_LOG_CHAT_ID=
ADMIN_LOG_THREAD_ID=

# --- Postgres (container beta_bot_postgres) ---
POSTGRES_USER=beta_bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beta_bot

# --- Backup web viewer ---
# Host port for the viewer (compose maps it to 127.0.0.1:<port>)
WEB_PUBLISH_PORT=8090
# Empty = no password. Set it if the port is reachable from anywhere but localhost.
WEB_PASSWORD=

# --- Local LLM ---
# Explicit address; empty = autodetect (see config.json "llm" and services/llm.py)
LLM_BASE_URL=
# llama-server key (--api-key / LLAMA_API_KEY for llm-qwen)
LLM_API_KEY=
